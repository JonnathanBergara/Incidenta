# Copiar este archivo a ".env" y ajustar los valores. ".env" no se versiona.

# --- Servidor ---
PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://incidenta:password@localhost:5432/incidenta?sslmode=disable

# --- Seguridad: JWT ---
# OBLIGATORIO, mínimo 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Vigencia del token en segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# --- CORS ---
# Orígenes autorizados a llamar la API desde otro dominio, separados por comas.
# Vacío = solo el mismo origen (el cliente servido por este mismo servidor).
CORS_ORIGINS=

# --- Límite de intentos de login (por IP) ---
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MS=900000

# --- HTTPS (ver docs/ARQUITECTURA-DESPLIEGUE.md) ---
# Opción A: TLS directo en Node
TLS_KEY_PATH=
TLS_CERT_PATH=
# Opción B: proxy inverso (Nginx/Caddy) que termina TLS
TRUST_PROXY=0
FORCE_HTTPS=false
PUBLIC_URL=

# En producción, definir contraseñas únicas antes del primer arranque.
SEED_ADMIN_PASSWORD=
SEED_ANALISTA_PASSWORD=
SEED_LECTOR_PASSWORD=
